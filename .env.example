# Airwallex SANDBOX credentials: sandbox web app → Account → Developer → API keys.
# Leave the key's IP allowlist empty. Never commit the real .env file.
AWX_CLIENT_ID=
AWX_API_KEY=

# Optional: lets Claude read emails, quotes and case notes and explain decisions.
# Without it, every kit uses deterministic rules and reaches the same decisions.
ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-sonnet-5-5

# Optional demo controls
# APPROVE=yes          # auto-approve every approval prompt (unattended runs)
# APPROVER=your-name   # name recorded on approvals
# DEMO_PACE=1500       # pause (ms) between story beats, for screen recordings
